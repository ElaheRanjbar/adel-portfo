PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/portfolio.sqlite
UPLOAD_DIR=./data/uploads
ADMIN_USERNAME=admin
# Required on the first start. Use a unique password of at least 12 characters.
ADMIN_PASSWORD=
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
NODE_ENV=development
# Production: set NODE_ENV=production behind HTTPS and bind HOST as needed.
# Static Angular output, relative to backend/:
FRONTEND_DIR=../dist/adel-portfo/browser
